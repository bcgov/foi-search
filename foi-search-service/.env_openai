# Global
LOG_LEVEL=INFO
LOG_FILE=
DEFAULT_PROVIDER=hugginface
# Provider
#PROVIDER_NAME=huggingface
PROVIDER_NAME=openai
#MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_NAME=text-embedding-3-small
EMBEDDING_DIM=384
COST_PER_1K=0.02
COST_PER_1M=0.02
SUPPORTS_BATCH=true
API_KEY=
API_BASE_URL=
MAX_RETRIES=3
RETRY_DELAY=1.0
MAX_BATCH_SIZE=100
TIMEOUT=30.0
# Tokenization
MAX_TOKEN_LENGTH=8192
MAX_WORDS_LENGTH=3200
TOKEN_CHAR_ESTIMATE=4
TOKEN_LANGUAGE=en
#Solr
SOLR_URL=http://localhost:8983/solr
SOLR_COLLECTION=vector_collection_384
SOLR_TIMEOUT=30.0
SOLR_MAX_RETRIES=3
SOLR_RETRY_DELAY=1.0
SOLR_VERIFY_SSL=true
SOLR_USERNAME=
SOLR_PASSWORD=
SOLR_DOC_PREFIX=doc
SOLR_BATCH_SIZE=100